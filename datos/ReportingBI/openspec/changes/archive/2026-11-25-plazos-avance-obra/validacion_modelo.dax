EVALUATE
GENERATE(
    SELECTCOLUMNS(FILTER(ALL(DimFecha[Fecha]),
        (DimFecha[Fecha] >= DATE(2025,1,31) && DimFecha[Fecha] <= MAX(DimCorteDatos[FechaCorte]) && DimFecha[Fecha] = EOMONTH(DimFecha[Fecha],0))
        || DimFecha[Fecha] IN {DATE(2025,1,1),DATE(2026,10,15)}),"Corte",DimFecha[Fecha]),
    VAR Fecha = [Corte]
    RETURN CALCULATETABLE(UNION(
        ROW("Grupo","TOTAL","Base",[Base de venta planificada],"PlanImporte",[Venta prevista acumulada],"Produccion",[Producción de plazos],"PlanPct",[Avance planificado],"RealPct",[Avance real],"DesviacionPP",[Desviación de avance],"Indice",[Índice de plazo],"SinFecha",[Venta sin fecha excluida],"Retrasados",[Hitos retrasados],"MaxDias",[Máximo retraso pendiente],"Tarde",[Hitos cumplidos tarde],"Pendientes",[Hitos pendientes],"ATiempo",[Hitos cumplidos a tiempo]),
        CALCULATETABLE(ROW("Grupo","OBRA:OB-25001","Base",[Base de venta planificada],"PlanImporte",[Venta prevista acumulada],"Produccion",[Producción de plazos],"PlanPct",[Avance planificado],"RealPct",[Avance real],"DesviacionPP",[Desviación de avance],"Indice",[Índice de plazo],"SinFecha",[Venta sin fecha excluida],"Retrasados",[Hitos retrasados],"MaxDias",[Máximo retraso pendiente],"Tarde",[Hitos cumplidos tarde],"Pendientes",[Hitos pendientes],"ATiempo",[Hitos cumplidos a tiempo]),TREATAS({"OB-25001"},DimObra[ObraClave])),
