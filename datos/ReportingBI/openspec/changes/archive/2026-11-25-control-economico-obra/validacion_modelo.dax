EVALUATE
VAR Cortes = SELECTCOLUMNS(
 FILTER(ALL(DimFecha[Fecha]), DimFecha[Fecha] >= DATE(2025,1,31) && DimFecha[Fecha] <= DATE(2026,10,31) && DimFecha[Fecha] = EOMONTH(DimFecha[Fecha],0)),
 "Corte", DimFecha[Fecha])
RETURN GENERATE(Cortes,
 VAR CorteActual = [Corte]
 RETURN UNION(
 SELECTCOLUMNS(
 CALCULATETABLE(SUMMARIZECOLUMNS(DimPartida[ObraClave],DimPartida[PartidaClave],"PptoCoste", [Presupuesto de coste],
"PptoVenta", [Presupuesto de venta],
"CosteReal", [Coste real],
"Certificado", [Importe certificado],
"Produccion", [Producción],
"Previsto", [Coste previsto],
"Directo", [Coste previsto directo],
"Indirecto", [Coste previsto indirecto],
"Pendiente", [Pendiente de certificar],
"MargenPrevisto", [Margen previsto],
"MargenReal", [Margen real],
"Desviacion", [Desviación de coste],
"CosteMensual", [Coste real mensual],
"CertMensual", [Certificado mensual],
"ProdMensual", [Producción mensual],
"BaseVenta", [Base de venta para producción],
"AvanceGlobal", [Avance global de obra],
"MargenPrevistoPct", [Margen previsto %],
"MargenRealPct", [Margen real %],
"DesviacionPct", [Desviación de coste %],
"Alerta", [Destacar partida]), REMOVEFILTERS(DimFecha), DATESBETWEEN(DimFecha[Fecha],DATE(YEAR(CorteActual),MONTH(CorteActual),1),CorteActual)),
 "Nivel","PARTIDA","Obra",DimPartida[ObraClave],"Partida",DimPartida[PartidaClave],"PptoCoste",[PptoCoste], "PptoVenta",[PptoVenta], "CosteReal",[CosteReal], "Certificado",[Certificado], "Produccion",[Produccion], "Previsto",[Previsto], "Directo",[Directo], "Indirecto",[Indirecto], "Pendiente",[Pendiente], "MargenPrevisto",[MargenPrevisto], "MargenReal",[MargenReal], "Desviacion",[Desviacion], "CosteMensual",[CosteMensual], "CertMensual",[CertMensual], "ProdMensual",[ProdMensual], "BaseVenta",[BaseVenta], "AvanceGlobal",[AvanceGlobal], "MargenPrevistoPct",[MargenPrevistoPct], "MargenRealPct",[MargenRealPct], "DesviacionPct",[DesviacionPct], "Alerta",[Alerta]),
 SELECTCOLUMNS(
 CALCULATETABLE(SUMMARIZECOLUMNS(DimObra[ObraClave],"PptoCoste", [Presupuesto de coste],
"PptoVenta", [Presupuesto de venta],
"CosteReal", [Coste real],
"Certificado", [Importe certificado],
"Produccion", [Producción],
"Previsto", [Coste previsto],
"Directo", [Coste previsto directo],
"Indirecto", [Coste previsto indirecto],
"Pendiente", [Pendiente de certificar],
"MargenPrevisto", [Margen previsto],
"MargenReal", [Margen real],
"Desviacion", [Desviación de coste],
"CosteMensual", [Coste real mensual],
"CertMensual", [Certificado mensual],
"ProdMensual", [Producción mensual],
"BaseVenta", [Base de venta para producción],
"AvanceGlobal", [Avance global de obra],
"MargenPrevistoPct", [Margen previsto %],
"MargenRealPct", [Margen real %],
"DesviacionPct", [Desviación de coste %],
"Alerta", [Destacar partida]), REMOVEFILTERS(DimFecha), DATESBETWEEN(DimFecha[Fecha],DATE(YEAR(CorteActual),MONTH(CorteActual),1),CorteActual)),
 "Nivel","OBRA","Obra",DimObra[ObraClave],"Partida","*","PptoCoste",[PptoCoste], "PptoVenta",[PptoVenta], "CosteReal",[CosteReal], "Certificado",[Certificado], "Produccion",[Produccion], "Previsto",[Previsto], "Directo",[Directo], "Indirecto",[Indirecto], "Pendiente",[Pendiente], "MargenPrevisto",[MargenPrevisto], "MargenReal",[MargenReal], "Desviacion",[Desviacion], "CosteMensual",[CosteMensual], "CertMensual",[CertMensual], "ProdMensual",[ProdMensual], "BaseVenta",[BaseVenta], "AvanceGlobal",[AvanceGlobal], "MargenPrevistoPct",[MargenPrevistoPct], "MargenRealPct",[MargenRealPct], "DesviacionPct",[DesviacionPct], "Alerta",[Alerta]),
 SELECTCOLUMNS(
 CALCULATETABLE(ROW("PptoCoste", [Presupuesto de coste],
"PptoVenta", [Presupuesto de venta],
"CosteReal", [Coste real],
"Certificado", [Importe certificado],
"Produccion", [Producción],
"Previsto", [Coste previsto],
"Directo", [Coste previsto directo],
"Indirecto", [Coste previsto indirecto],
"Pendiente", [Pendiente de certificar],
"MargenPrevisto", [Margen previsto],
"MargenReal", [Margen real],
"Desviacion", [Desviación de coste],
"CosteMensual", [Coste real mensual],
"CertMensual", [Certificado mensual],
"ProdMensual", [Producción mensual],
"BaseVenta", [Base de venta para producción],
"AvanceGlobal", [Avance global de obra],
"MargenPrevistoPct", [Margen previsto %],
"MargenRealPct", [Margen real %],
"DesviacionPct", [Desviación de coste %],
"Alerta", [Destacar partida]), REMOVEFILTERS(DimFecha), DATESBETWEEN(DimFecha[Fecha],DATE(YEAR(CorteActual),MONTH(CorteActual),1),CorteActual)),
 "Nivel","TOTAL","Obra","*","Partida","*","PptoCoste",[PptoCoste], "PptoVenta",[PptoVenta], "CosteReal",[CosteReal], "Certificado",[Certificado], "Produccion",[Produccion], "Previsto",[Previsto], "Directo",[Directo], "Indirecto",[Indirecto], "Pendiente",[Pendiente], "MargenPrevisto",[MargenPrevisto], "MargenReal",[MargenReal], "Desviacion",[Desviacion], "CosteMensual",[CosteMensual], "CertMensual",[CertMensual], "ProdMensual",[ProdMensual], "BaseVenta",[BaseVenta], "AvanceGlobal",[AvanceGlobal], "MargenPrevistoPct",[MargenPrevistoPct], "MargenRealPct",[MargenRealPct], "DesviacionPct",[DesviacionPct], "Alerta",[Alerta])
 ))
ORDER BY [Corte],[Nivel],[Obra],[Partida]
