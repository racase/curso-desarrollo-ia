/// Calendario del 01/01/2025 al 31/12/2027: cubre presupuesto, movimientos y mediciones.
table Calendario
	lineageTag: bb6a7133-10da-471c-8fb1-325050a6a09c
	dataCategory: Time

	column Fecha
		isUnique
		formatString: dd/mm/yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fecha]

	column Año
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Año]

	column MesNumero
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [MesNumero]

	column Mes
		isNameInferred
		sourceColumn: [Mes]
		sortByColumn: MesNumero

	column AñoMes
		isNameInferred
		sourceColumn: [AñoMes]

	partition Calendario = calculated
		mode: import
		source =
				VAR Dias = CALENDAR(DATE(2025, 1, 1), DATE(2027, 12, 31))
				RETURN
				    SELECTCOLUMNS(
				        Dias,
				        "Fecha", [Date],
				        "Año", YEAR([Date]),
				        "MesNumero", MONTH([Date]),
				        "Mes", FORMAT([Date], "mmmm"),
				        "AñoMes", FORMAT([Date], "yyyy-mm")
				    )

