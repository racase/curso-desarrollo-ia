model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Servidor","BaseDatos","DimObra","DimCapitulo","FactPresupuesto","FactMovimiento","FactProduccion"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table DimObra
ref table DimCapitulo
ref table FactPresupuesto
ref table FactMovimiento
ref table FactProduccion
ref table Calendario

ref cultureInfo es-ES

